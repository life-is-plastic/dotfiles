alias reload='. ~/.zshrc'
alias profile='vim ~/.zshrc'
alias aliases='vim ~/.zsh_aliases'
alias ls='gls -Fl --group-directories-first --color=auto'

alias p='uv run python3'
alias g='git'
alias gitconfig='git config --global --edit'
alias pi='EDITOR=vim PI_OFFLINE=1 pi'

mac_update() {
	sudo port selfupdate
	sudo port upgrade outdated

	$(go env GOPATH)/bin/gup update

	uv self update
	uv upgrade python

	rustup update
	cargo-install-update install-update --all
}

mac_clean() {
	sudo port uninstall inactive
	sudo port uninstall leaves
}

c() {
	local directory=${1}
	local subdir=${2}
	case $directory in
		dev)
			cd ~/dev/$subdir
			;;
		*)
			;;
	esac
}

did() {
	local fp=~/did.txt
	if [ $# -eq 0 ]; then
		cat $fp
	else
		echo "[$(date '+%Y-%m')] $*" | tee -a $fp
	fi
}
